<?php

/**
 * @file
 * Install, update and uninstall functions for the Event Flow module.
 */

/**
 * Implements hook_install().
 */
function event_flow_install() {
  // Grant 'register for events' permission to authenticated users.
  if (\Drupal::moduleHandler()->moduleExists('user')) {
    user_role_grant_permissions('authenticated', ['register for events']);
  }
}

/**
 * Implements hook_uninstall().
 */
function event_flow_uninstall() {
  // Clean up cache entries.
  \Drupal::cache()->invalidateAll();
}